<?xml version="1.0" encoding="UTF-8"?>
<!--
  Thermal camera payload. swarmsim mounts it on a vehicle with a fixed joint
  to the vehicle's base_link, so it has one link and no pose of its own.
  The image is L16: each pixel is a temperature in kelvin, in steps of
  0.01 K, on /world/<world>/model/<drone>/model/<payload>/link/thermal_link/sensor/thermal/image.
-->
<sdf version='1.9'>
  <model name='thermal_cam'>
    <self_collide>false</self_collide>
    <link name="thermal_link">
      <inertial>
        <mass>0.035</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="housing">
        <geometry>
          <box>
            <size>0.03 0.04 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <visual name="lens">
        <pose>0.016 0 0 0 1.5707 0</pose>
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.6 0.3 0 1</ambient>
          <diffuse>0.6 0.3 0 1</diffuse>
        </material>
      </visual>
      <sensor name="thermal" type="thermal">
        <gz_frame_id>thermal_link</gz_frame_id>
        <pose>0.02 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>0.96</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>L16</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>
  </model>
</sdf>
